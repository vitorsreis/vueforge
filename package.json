{
  "name": "@vitorsreis/vueforge",
  "version": "1.0.0",
  "description": "A standalone Vue SSR renderer for backends in any language",
  "author": "Vitor Reis",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/vitorsreis/vueforge#readme",
  "bugs": {
    "url": "https://github.com/vitorsreis/vueforge/issues"
  },
  "keywords": [
    "vue",
    "ssr",
    "server-side-rendering",
    "vite",
    "renderer"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin/vueforge",
    "docs",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "vueforge": "bin/vueforge"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:coverage": "npm run build && node --test --test-concurrency=1 --experimental-test-coverage \"tests/*.test.mjs\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:browser": "npm run build && node tests/browser-smoke.mjs",
    "prepack": "npm run build",
    "test:qualification": "node tests/qualify-package.mjs",
    "bench:render": "npm run build && node benchmarks/render.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "express": "^5.3.0",
    "host-validation-middleware": "0.1.4",
    "negotiator": "^1.1.0",
    "parse5": "^8.0.0",
    "vite": "^8.3.8",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/negotiator": "^0.6.5",
    "eslint": "^10.15.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorsreis/vueforge.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
