{
  "name": "vueforge",
  "version": "0.0.0",
  "private": true,
  "description": "A standalone Vue SSR renderer for backends in any language",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "26.x"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/index.d.ts",
    "bin/vueforge",
    "docs",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "vueforge": "bin/vueforge"
  },
  "scripts": {
    "build": "node node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:browser": "npm run build && node tests/browser-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "express": "^5.3.0",
    "vite": "^8.3.8",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "typescript7": "npm:typescript@^7.0.2"
  }
}
