#!/usr/bin/env node
import console from 'node:console'
import process from 'node:process'

import {
  loadProjectConfig,
  resolveMode,
  resolveTempDir,
} from '../dist/config.js'
import { listenOptions } from '../dist/server/transports/config.js'
import { buildProject } from '../dist/build.js'
import { CliUsageError, parseCliArguments } from '../dist/cli/arguments.js'
import { help } from '../dist/cli/help.js'
import { renderProject } from '../dist/cli/render.js'
import { packageVersion } from '../dist/cli/version.js'
import { serveProject } from '../dist/server/serve.js'

async function main() {
  const args = parseCliArguments(process.argv.slice(2))

  if (args.help) {
    console.log(help(args.command))
    return
  }

  if (args.version) {
    console.log(packageVersion)
    return
  }

  if (args.command === undefined) {
    console.log(help())
    return
  }

  const root = args.root === undefined ? process.cwd() : args.root
  if (args.command === 'render') {
    await renderProject(
      root,
      args.format,
      args.config,
      args.limits,
      args.pretty,
      args.hydrate,
      args.template,
    )
    return
  }

  const requestedDev = args.command === 'serve' && args.dev
  const config = await loadProjectConfig(
    root,
    {
      command: args.command === 'build' ? 'build' : 'serve',
      mode: requestedDev ? 'development' : 'production',
    },
    args.config,
    undefined,
    undefined,
    args.command === 'build'
      ? 'production'
      : args.devSpecified
        ? requestedDev
          ? 'development'
          : 'production'
        : undefined,
  )
  const dev =
    args.command === 'serve' &&
    (requestedDev ||
      (!args.devSpecified && resolveMode(config.mode) === 'development'))
  const projectRoot = config.root ?? root
  if (args.limits !== undefined) {
    config.limits = { ...config.limits, ...args.limits }
  }
  if (args.ssl !== undefined) {
    if (args.ssl.key === undefined || args.ssl.cert === undefined) {
      throw new CliUsageError('--ssl-key and --ssl-cert are required together.')
    }
    config.server = {
      ...config.server,
      ssl: { ...args.ssl, key: args.ssl.key, cert: args.ssl.cert },
    }
  }
  if (args.shutdownTimeoutMs !== undefined) {
    config.server = {
      ...config.server,
      shutdownTimeoutMs: args.shutdownTimeoutMs,
    }
  }
  if (args.command === 'build') {
    const tempDir = resolveTempDir(projectRoot, config.tempDir)
    await buildProject(projectRoot, tempDir, config)
    return
  }

  const listener = listenOptions(config, args.host, args.port)
  await serveProject(
    projectRoot,
    dev,
    {
      ...listener,
      ...(args.unix === undefined ? {} : { unix: args.unix }),
      ...(args.stdio ? { stdio: true } : {}),
    },
    config,
  )
}

try {
  await main()
} catch (error) {
  if (error instanceof CliUsageError) {
    console.error(`Error: ${error.message}`)
    console.error('')
    console.error(help())
    process.exitCode = error.exitCode
  } else {
    console.error(error instanceof Error ? error.message : error)
    process.exitCode = 1
  }
}
